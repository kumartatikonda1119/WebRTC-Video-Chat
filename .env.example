# App server port
PORT=3000

# STUN server exposed to the browser for ICE discovery
NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302

# Optional override for Socket.IO CORS origin in production
SOCKET_IO_CORS_ORIGIN=*

# Optional TURN server (recommended when participants are on different networks)
# NEXT_PUBLIC_TURN_URL=turn:your-turn-server:3478
# NEXT_PUBLIC_TURN_USERNAME=your-turn-username
# NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-password
